{
  "note": "MCP 公开工具名的黄金值 —— 只有一份实现（virlen-core/src/mcp/naming.rs），这里是它的断言输入。名字 = 服务器自己的工具名；发生字符替换 / 空名 / 超 64 字符 / 以历史前缀 mcp__ 开头时追加 raw 的 SHA-256 前 12 位十六进制。",
  "maxLength": 64,
  "hashLength": 12,
  "cases": [
    {
      "raw": "create_issue",
      "expected": "create_issue",
      "why": "干净名：原样返回（不再拼服务器名）"
    },
    {
      "raw": "list/files",
      "expected": "list_files_52db686404e5",
      "why": "斜杠被替换 → 必须追加哈希，否则会与 list_files 折叠"
    },
    {
      "raw": "读取",
      "expected": "___534cb3fa8fbf",
      "why": "非 ASCII 逐字符替换成一个下划线（不按字节，避免长度随编码漂移）"
    },
    {
      "raw": "b",
      "expected": "b",
      "why": "最短干净名"
    },
    {
      "raw": "read_file",
      "expected": "read_file",
      "why": "下划线本身合法，不触发哈希（与内置同名是运行时冲突，由管理器判定）"
    },
    {
      "raw": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa_635361c48bb9",
      "why": "65 字符超长 → 保留头部 51 字符 + 1 下划线 + 12 位哈希"
    },
    {
      "raw": "search.v2",
      "expected": "search_v2_45ec3246881a",
      "why": "点号被替换"
    },
    {
      "raw": "mcp__blender__look",
      "expected": "mcp_tool_blender__look_3a689a900eb7",
      "why": "占用历史前缀 → 换成中性前缀 + 指纹，否则会被当成旧版名解析出错误的服务器"
    }
  ]
}
